# Open port 443 so nginx can serve the HTTPS site (see .platform/hooks/postdeploy/03_https.sh).
Resources:
  HttpsIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0
